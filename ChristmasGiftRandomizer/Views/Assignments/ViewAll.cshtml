@model ChristmasGiftRandomizer.ViewModels.AllAssignmentsViewModel
@{
    ViewData["Title"] = "All Assignments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>All Assignments</h2>
        <p class="text-muted mb-0">@Model.Exchange.Name - @Model.Exchange.Year</p>
    </div>
    <div>
        <span class="badge bg-warning">Organizer View</span>
    </div>
</div>

<div class="alert alert-warning">
    <strong>Note:</strong> As the organizer, you can see all assignments. Regular participants can only see their own assignment.
</div>

@if (Model.Assignments.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Giver</th>
                    <th>Giver Email</th>
                    <th>→</th>
                    <th>Receiver</th>
                    <th>Receiver Email</th>
                    <th>Notified</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var assignment in Model.Assignments)
                {
                    <tr>
                        <td><strong>@assignment.GiverName</strong></td>
                        <td>@assignment.GiverEmail</td>
                        <td class="text-center">→</td>
                        <td><strong>@assignment.ReceiverName</strong></td>
                        <td>@assignment.ReceiverEmail</td>
                        <td>
                            @if (assignment.NotifiedAt.HasValue)
                            {
                                <span class="badge bg-success">Yes</span>
                                <br />
                                <small class="text-muted">@assignment.NotifiedAt.Value.ToString("MM/dd/yyyy HH:mm")</small>
                            }
                            else
                            {
                                <span class="badge bg-warning">Pending</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        <p>No assignments found for this exchange.</p>
    </div>
}

<div class="mt-4">
    <a asp-controller="Exchanges" asp-action="Details" asp-route-id="@Model.Exchange.Id" class="btn btn-secondary">Back to Exchange</a>
</div>

