@model ChristmasGiftRandomizer.ViewModels.ExchangeDetailsViewModel
@{
    ViewData["Title"] = "Exchange Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>@Model.Exchange.Name</h2>
        <p class="text-muted mb-0">@Model.Group.Name - @Model.Exchange.Year</p>
    </div>
    <div>
        @switch (Model.Exchange.Status)
        {
            case ChristmasGiftRandomizer.Models.ExchangeStatus.Draft:
                <span class="badge bg-secondary fs-6">Draft</span>
                break;
            case ChristmasGiftRandomizer.Models.ExchangeStatus.Active:
                <span class="badge bg-success fs-6">Active</span>
                break;
            case ChristmasGiftRandomizer.Models.ExchangeStatus.Completed:
                <span class="badge bg-primary fs-6">Completed</span>
                break;
        }
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row mb-4">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">Event Date:</dt>
            <dd class="col-sm-8">@(Model.Exchange.EventDate?.ToString("MMMM dd, yyyy") ?? "Not set")</dd>
            
            <dt class="col-sm-4">Participants:</dt>
            <dd class="col-sm-8">@Model.Participants.Count</dd>
            
            @if (Model.Exchange.MatchedAt.HasValue)
            {
                <dt class="col-sm-4">Matched On:</dt>
                <dd class="col-sm-8">@Model.Exchange.MatchedAt.Value.ToString("MMMM dd, yyyy 'at' h:mm tt")</dd>
            }
        </dl>
    </div>
</div>

@if (Model.IsOrganizer && Model.CanGenerateMatches && !Model.HasAssignments)
{
    <div class="alert alert-warning mb-4">
        <h5>Ready to Generate Matches</h5>
        <p>This exchange has @Model.Participants.Count participant(s). Click the button below to generate secret Santa assignments.</p>
        <form asp-action="GenerateMatches" method="post" class="d-inline">
            <input type="hidden" name="id" value="@Model.Exchange.Id" />
            <button type="submit" class="btn btn-primary" 
                    onclick="return confirm('Are you sure you want to generate matches? This action cannot be undone and will send emails to all participants.')">
                Generate Matches
            </button>
        </form>
    </div>
}

@if (Model.HasAssignments && Model.IsOrganizer)
{
    <div class="mb-4">
        <h4>All Assignments</h4>
        <p class="text-muted">As the organizer, you can see all matches. Participants can only see their own assignment.</p>
        <a asp-controller="Assignments" asp-action="ViewAll" asp-route-exchangeId="@Model.Exchange.Id" class="btn btn-outline-primary">
            View All Assignments
        </a>
    </div>
}

<h4>Participants (@Model.Participants.Count)</h4>

@if (Model.Participants.Any())
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Restrictions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var participant in Model.Participants)
                {
                    <tr>
                        <td>@participant.Name</td>
                        <td>@participant.Email</td>
                        <td>
                            @if (participant.RestrictedParticipantIds.Any())
                            {
                                var restrictedNames = Model.Participants
                                    .Where(p => participant.RestrictedParticipantIds.Contains(p.Id))
                                    .Select(p => p.Name);
                                <span class="badge bg-warning">@string.Join(", ", restrictedNames)</span>
                            }
                            else
                            {
                                <span class="text-muted">None</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        <p>No participants in this exchange yet.</p>
    </div>
}

<div class="mt-4">
    <a asp-action="Index" class="btn btn-secondary">Back to Exchanges</a>
</div>

