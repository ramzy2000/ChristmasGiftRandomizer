@model ChristmasGiftRandomizer.Models.Exchange
@{
    ViewData["Title"] = "Delete Exchange";
}

<h2>Delete Exchange</h2>
<h3>Are you sure you want to delete this exchange?</h3>
<div>
    <h4>@Model.Name</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Name:</dt>
        <dd class="col-sm-10">@Model.Name</dd>
        
        <dt class="col-sm-2">Year:</dt>
        <dd class="col-sm-10">@Model.Year</dd>
        
        <dt class="col-sm-2">Status:</dt>
        <dd class="col-sm-10">
            @switch (Model.Status)
            {
                case ChristmasGiftRandomizer.Models.ExchangeStatus.Draft:
                    <span class="badge bg-secondary">Draft</span>
                    break;
                case ChristmasGiftRandomizer.Models.ExchangeStatus.Active:
                    <span class="badge bg-success">Active</span>
                    break;
                case ChristmasGiftRandomizer.Models.ExchangeStatus.Completed:
                    <span class="badge bg-primary">Completed</span>
                    break;
            }
        </dd>
        
        @if (Model.EventDate.HasValue)
        {
            <dt class="col-sm-2">Event Date:</dt>
            <dd class="col-sm-10">@Model.EventDate.Value.ToString("MMMM dd, yyyy")</dd>
        }
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>

