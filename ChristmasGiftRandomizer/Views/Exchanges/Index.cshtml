@model IEnumerable<ChristmasGiftRandomizer.Models.Exchange>
@{
    ViewData["Title"] = "My Exchanges";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>@ViewData["Title"]</h2>
    <a asp-action="Create" class="btn btn-primary">Create New Exchange</a>
</div>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Group</th>
                    <th>Year</th>
                    <th>Status</th>
                    <th>Event Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var exchange in Model)
                {
                    <tr>
                        <td>@exchange.Name</td>
                        <td>@exchange.Group?.Name</td>
                        <td>@exchange.Year</td>
                        <td>
                            @switch (exchange.Status)
                            {
                                case ChristmasGiftRandomizer.Models.ExchangeStatus.Draft:
                                    <span class="badge bg-secondary">Draft</span>
                                    break;
                                case ChristmasGiftRandomizer.Models.ExchangeStatus.Active:
                                    <span class="badge bg-success">Active</span>
                                    break;
                                case ChristmasGiftRandomizer.Models.ExchangeStatus.Completed:
                                    <span class="badge bg-primary">Completed</span>
                                    break;
                            }
                        </td>
                        <td>@(exchange.EventDate?.ToString("MMMM dd, yyyy") ?? "Not set")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@exchange.Id" class="btn btn-sm btn-outline-primary">View</a>
                            @if (exchange.Status == ChristmasGiftRandomizer.Models.ExchangeStatus.Draft)
                            {
                                <a asp-action="Delete" asp-route-id="@exchange.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        <h4>No exchanges yet</h4>
        <p>Create your first exchange to start organizing gift exchanges!</p>
        <a asp-action="Create" class="btn btn-primary">Create Your First Exchange</a>
    </div>
}

