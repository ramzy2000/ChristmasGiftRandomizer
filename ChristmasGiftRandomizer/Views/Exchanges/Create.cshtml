@model ChristmasGiftRandomizer.ViewModels.CreateExchangeViewModel
@{
    ViewData["Title"] = "Create Exchange";
}

<h2>@ViewData["Title"]</h2>
<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group mb-3">
                <label asp-for="GroupId" class="control-label"></label>
                <select asp-for="GroupId" class="form-select" asp-items="@(new SelectList(Model.AvailableGroups, "Id", "Name", Model.GroupId))">
                    <option value="">-- Select a Group --</option>
                </select>
                <span asp-validation-for="GroupId" class="text-danger"></span>
                @if (Model.AvailableGroups.Any())
                {
                    <small class="form-text text-muted">
                        Selected group has @Model.AvailableGroups.FirstOrDefault(g => g.Id == Model.GroupId)?.ParticipantCount participants
                    </small>
                }
            </div>

            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Year" class="control-label"></label>
                <input asp-for="Year" class="form-control" type="number" min="2020" max="2100" />
                <span asp-validation-for="Year" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="EventDate" class="control-label"></label>
                <input asp-for="EventDate" class="form-control" type="date" />
                <span asp-validation-for="EventDate" class="text-danger"></span>
            </div>

            <div class="alert alert-info">
                <strong>Note:</strong> All participants from the selected group will be automatically added to this exchange. 
                You can modify participants and restrictions after creation.
            </div>

            <div class="form-group">
                <input type="submit" value="Create Exchange" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

