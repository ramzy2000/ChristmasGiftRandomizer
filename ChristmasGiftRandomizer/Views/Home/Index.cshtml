@{
    ViewData["Title"] = "Home";
}

<div class="row justify-content-center">
    <div class="col-md-8 text-center">
        <h1 class="display-4 mb-4">🎄 Christmas Gift Exchange Generator</h1>
        <p class="lead mb-4">
            Organize and manage your secret Santa gift exchanges with ease. 
            Create groups, set restrictions, and automatically generate matches.
        </p>
        
        <div class="card shadow-sm mb-4" style="background-color: rgba(252, 248, 232, 0.9);">
            <div class="card-body p-4">
                <h4 class="mb-3">Welcome to the Christmas Gift Exchange Generator</h4>
                <ol class="text-start" style="max-width: 500px; margin: 0 auto;">
                    <li>Create an account or login to get started</li>
                    <li>Create a group and add participants</li>
                    <li>Set up restrictions (who can't gift whom)</li>
                    <li>Create an exchange and generate matches</li>
                    <li>Participants receive email notifications with their assignments</li>
                </ol>
            </div>
        </div>

        <div class="d-grid gap-2 d-md-flex justify-content-md-center">
            <a asp-controller="Account" asp-action="Register" class="btn btn-lg" style="background-color: #DF7861; color: white;">Get Started</a>
            <a asp-controller="Account" asp-action="Login" class="btn btn-lg btn-outline-secondary">Login</a>
        </div>
    </div>
</div>
