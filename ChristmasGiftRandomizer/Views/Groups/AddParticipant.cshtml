@model ChristmasGiftRandomizer.ViewModels.ParticipantViewModel
@{
    ViewData["Title"] = "Add Participant";
    var groupId = ViewData["GroupId"] as Guid?;
    var groupName = ViewData["GroupName"] as string;
}

<h2>Add Participant to @groupName</h2>
<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="AddParticipant" method="post">
            <input type="hidden" name="groupId" value="@groupId" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control" type="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Cannot Gift To (Restrictions)</label>
                <p class="text-muted small">Select participants this person cannot be matched with:</p>
                @if (Model.AvailableParticipants.Any())
                {
                    @foreach (var participant in Model.AvailableParticipants)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" 
                                   name="RestrictedParticipantIds" 
                                   value="@participant.Id" 
                                   id="restriction_@participant.Id"
                                   @(Model.RestrictedParticipantIds.Contains(participant.Id) ? "checked" : "") />
                            <label class="form-check-label" for="restriction_@participant.Id">
                                @participant.Name
                            </label>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted">No other participants yet. Restrictions can be added after more participants are created.</p>
                }
            </div>

            <div class="form-group">
                <input type="submit" value="Add Participant" class="btn btn-primary" />
                <a asp-action="Details" asp-route-id="@groupId" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

