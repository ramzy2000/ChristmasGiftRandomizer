@model IEnumerable<ChristmasGiftRandomizer.Models.Group>
@{
    ViewData["Title"] = "My Groups";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>@ViewData["Title"]</h2>
    <a asp-action="Create" class="btn btn-primary">Create New Group</a>
</div>

@if (Model.Any())
{
    <div class="row">
        @foreach (var group in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@group.Name</h5>
                        @if (!string.IsNullOrEmpty(group.Description))
                        {
                            <p class="card-text text-muted">@group.Description</p>
                        }
                        <p class="card-text">
                            <small class="text-muted">
                                Created: @group.CreatedAt.ToString("MMMM dd, yyyy")
                            </small>
                        </p>
                    </div>
                    <div class="card-footer">
                        <a asp-action="Details" asp-route-id="@group.Id" class="btn btn-sm btn-outline-primary">View</a>
                        <a asp-action="Edit" asp-route-id="@group.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@group.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info">
        <h4>No groups yet</h4>
        <p>Create your first group to start organizing gift exchanges!</p>
        <a asp-action="Create" class="btn btn-primary">Create Your First Group</a>
    </div>
}

